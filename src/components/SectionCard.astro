---
import type { Cp2020Section } from '../data/cp2020-sections'

interface Props {
  section: Cp2020Section
}

const { section } = Astro.props
---

<a
  class="section-card"
  data-section-card
  href={`/cp2020/${section.slug}/`}
>
  <span class="section-card__avatar" aria-hidden="true">
    <span class="section-card__signal"></span>
    <span class="section-card__code">{section.code}</span>
  </span>
  <span class="section-card__body">
    <span class="section-card__heading">
      <strong>{section.title}</strong>
      <small>{section.titleEn}</small>
    </span>
    <span class="section-card__description">{section.description}</span>
  </span>
  <svg class="section-card__arrow" aria-hidden="true" viewBox="0 0 20 20">
    <path d="M4 10h11m-4-4 4 4-4 4" />
  </svg>
</a>
