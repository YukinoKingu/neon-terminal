---
interface Props {
  pathname: string
}

const { pathname } = Astro.props
const isCp2020 = pathname.startsWith('/cp2020')
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href="/" aria-label="NEON TERMINAL — главная">
      <span class="brand__mark" aria-hidden="true">N//T</span>
      <span class="brand__label">
        <strong>NEON//TERMINAL</strong>
        <small>справочник по тёмному будущему</small>
      </span>
    </a>
    <nav class="site-nav" aria-label="Основная навигация">
      <a class:list={['site-nav__link', { 'is-active': !isCp2020 }]} href="/">Обзор</a>
      <a class:list={['site-nav__link', { 'is-active': isCp2020 }]} href="/cp2020/">Cyberpunk 2020</a>
    </nav>
    <span class="system-status" aria-label="Редакция правил 2.01">
      <span class="system-status__light" aria-hidden="true"></span>
      Core 2.01
    </span>
  </div>
</header>
