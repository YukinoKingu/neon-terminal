---
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'cp2020Roles'>
  skills: CollectionEntry<'cp2020Skills'>[]
}

const { entry, skills } = Astro.props
const { data } = entry
function normalizeSkillName(name: string) {
  return name
  .toLocaleLowerCase('ru-RU')
  .replace(/[«»"'().,]/g, '')
  .replace(/\s+/g, ' ')
  .trim()
}
function resolveSkill(name: string) {
  const normalizedName = normalizeSkillName(name)
  return skills.find(({ data: skillData }) => [skillData.title, ...skillData.aliases]
    .some(alias => normalizeSkillName(alias) === normalizedName))
}
const careerSkills = data.careerSkills.map((name) => {
  if (name === 'Драка или Боевые искусства') {
    return {
      prefix: '',
      separator: ' или ',
      links: ['Драка', 'Боевые искусства'].map(label => ({ label, skill: resolveSkill(label) })),
    }
  }

  if (name.startsWith('Любые 3 из навыков: ')) {
    const prefix = 'Любые 3 из навыков: '
    return {
      prefix,
      separator: ', ',
      links: name.slice(prefix.length).split(', ').map(label => ({ label, skill: resolveSkill(label) })),
    }
  }

  return {
    prefix: '',
    separator: '',
    links: [{ label: name, skill: resolveSkill(name) }],
  }
})
const portraitCode = data.titleEn
  .split(/\s+/)
  .map(part => part[0])
  .join('')
  .slice(0, 3)
  .toUpperCase()
const sourceLabel = data.source === 'core-rulebook'
  ? 'Основная книга правил'
  : data.source
const abilityRankDetails = [...data.specialAbility.rank.details]
  .sort((first, second) => first.level - second.level)
---

<header class="role-hero">
  <div class="role-portrait" aria-label={`Заглушка портрета роли ${data.title}`}>
    <span class="role-portrait__status">SIGNAL://NO_SOURCE</span>
    <span class="role-portrait__code" aria-hidden="true">{portraitCode}</span>
    <span class="role-portrait__scan" aria-hidden="true"></span>
    <span class="role-portrait__id">ROLE/{entry.id.toUpperCase()}</span>
  </div>

  <div class="role-hero__content">
    <p class="eyebrow">&gt; role dossier / {entry.id}</p>
    <h1 class="role-hero__title">{data.title}</h1>
    <p class="role-hero__title-en">{data.titleEn}</p>
    <p class="role-hero__summary">{data.summary}</p>

    <dl class="role-facts">
      <div>
        <dt>Система</dt>
        <dd>Cyberpunk 2020</dd>
      </div>
      <div>
        <dt>Редакция</dt>
        <dd>{data.edition}</dd>
      </div>
      <div>
        <dt>Источник</dt>
        <dd>{sourceLabel}</dd>
      </div>
    </dl>
  </div>
</header>

<div class="role-layout">
  <aside class="role-sidebar">
    <nav class="role-toc" aria-label="Содержание страницы">
      <p class="role-toc__label">Навигация</p>
      <a href="#special-ability">01 // Способность и ранги</a>
      <a href="#career-skills">02 // Навыки</a>
      <a href="#description">03 // Описание</a>
    </nav>
  </aside>

  <div class="role-main">
    <section id="special-ability" class="role-ability" aria-labelledby="special-ability-title">
      <p class="role-section-code">SPECIAL_ABILITY</p>
      <h2 id="special-ability-title">{data.specialAbility.title}</h2>
      <p class="role-ability__title-en">{data.specialAbility.titleEn}</p>
      <p class="role-ability__description">{data.specialAbility.description}</p>
      <p class="role-progression__range">
        Ранг {data.specialAbility.rank.min}–{data.specialAbility.rank.max}
      </p>
      <p class="role-progression__description">{data.specialAbility.rank.progression}</p>
      <ol class="role-ability-ranks" aria-label="Эффекты рангов специальной способности">
        {abilityRankDetails.map(({ level, effect }) => (
          <li>
            <span>РАНГ {String(level).padStart(2, '0')}</span>
            <p>{effect}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="career-skills" class="role-career-skills" aria-labelledby="career-skills-title">
      <div class="role-section-heading">
        <p class="role-section-code">CAREER_SKILLS</p>
        <h2 id="career-skills-title">Профессиональные навыки</h2>
      </div>
      {data.careerSkills.length > 0
? (
        <ol class="role-skill-list">
          {careerSkills.map((careerSkill, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              {careerSkill.prefix}
              {careerSkill.links.map(({ label, skill }, linkIndex) => (
                <span>
                  {linkIndex > 0 && careerSkill.separator}
                  {skill
                    ? <a href={`/cp2020/skills/${skill.id}/`}>{label}</a>
                    : label}
                </span>
              ))}
            </li>
          ))}
        </ol>
      )
: (
        <p class="role-career-skills__empty">Список навыков ожидает проверки по источнику.</p>
      )}
    </section>

    <section id="description" class="role-description" aria-labelledby="description-title">
      <div class="role-section-heading">
        <p class="role-section-code">ROLE_PROFILE</p>
        <h2 id="description-title">Описание роли</h2>
      </div>
      <div class="prose">
        <slot />
      </div>
    </section>
  </div>
</div>
