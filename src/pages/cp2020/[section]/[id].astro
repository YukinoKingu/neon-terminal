---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import Breadcrumbs from '../../../components/Breadcrumbs.astro'
import RoleDetail from '../../../components/RoleDetail.astro'
import {
  cp2020Sections,
  type Cp2020CollectionName,
  type Cp2020Section,
} from '../../../data/cp2020-sections'
import Layout from '../../../layouts/Layout.astro'

type Cp2020Entry = CollectionEntry<Cp2020CollectionName>

interface Props {
  section: Cp2020Section
  entry: Cp2020Entry
}

export async function getStaticPaths() {
  const sectionPaths = await Promise.all(cp2020Sections.map(async (section) => {
    const entries = await getCollection(
      section.collection,
      ({ data }) => data.status === 'published' || import.meta.env.DEV,
    )

    return entries.map(entry => ({
      params: { section: section.slug, id: entry.id },
      props: { section, entry },
    }))
  }))

  return sectionPaths.flat()
}

const { section, entry } = Astro.props
const { Content } = await render(entry)
const isRole = entry.collection === 'cp2020Roles'
const skills = isRole
  ? await getCollection('cp2020Skills', ({ data }) => data.status === 'published' || import.meta.env.DEV)
  : []
---

<Layout title={entry.data.title} description={entry.data.summary}>
  <article class:list={['page-section', isRole ? 'role-shell' : 'article-shell']}>
    <Breadcrumbs items={[
      { label: 'Главная', href: '/' },
      { label: 'Cyberpunk 2020', href: '/cp2020/' },
      { label: section.title, href: `/cp2020/${section.slug}/` },
      { label: entry.data.title },
    ]} />

    {isRole
      ? (
          <RoleDetail entry={entry} skills={skills}>
            <Content />
          </RoleDetail>
        )
      : (
          <>
            <header class="article-header">
              <p class="eyebrow">&gt; record/{entry.id}</p>
              <h1 class="article-header__title">{entry.data.title}</h1>
              <p class="article-header__title-en">{entry.data.titleEn}</p>
              <div class="article-meta">
                <span>Cyberpunk 2020</span>
                <span>редакция {entry.data.edition}</span>
                <span>основная книга правил</span>
              </div>
            </header>

            <div class="prose">
              <Content />
            </div>
          </>
        )}

    <aside class="legal-notice">
      Это неофициальная краткая справочная запись. Для полного текста и контекста используйте
      официальную основную книгу правил Cyberpunk 2020.
    </aside>
  </article>
</Layout>
